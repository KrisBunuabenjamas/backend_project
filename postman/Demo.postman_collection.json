{
  "info": {
    "name": "Restaurant Reservation - Demo (Additional Requirements)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Click Send on each request from top to bottom. Tokens, IDs and the check-in code are saved automatically. Use the \"Restaurant Reservation - Local\" environment with adminEmail/adminPassword set. Run after npm run seed (uses demo restaurant 700000000000000000000001)."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('demoRun') || pm.info.requestName.startsWith('2.')) pm.collectionVariables.set('demoRun', Date.now().toString());",
          "pm.collectionVariables.set('today', new Date(Date.now() + 7 * 60 * 60 * 1000).toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "variable": [],
  "item": [
    {
      "name": "1. Admin logs in",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300) pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Customer registers",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Customer\",\n  \"tel\": \"0812345678\",\n  \"email\": \"customer-{{demoRun}}@example.com\",\n  \"password\": \"Demo-pass-123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.collectionVariables.set('userToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. [Req 1] Admin adds Som Tum 80 baht to the menu",
      "request": {
