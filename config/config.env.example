NODE_ENV=development
PORT=5000
# MongoDB Atlas URI including the database name.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/restaurant_final?retryWrites=true&w=majority
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
# Optional, used only by npm run create-admin. Set locally; never commit real values.
ADMIN_NAME=
ADMIN_TEL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
